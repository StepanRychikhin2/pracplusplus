  <diagram id="page-3" name="Бульбашкове сортування">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="2600" pageScale="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Початок BubleSort" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="init" value="countSort = 0; swaps = 0&#10;step = 0; swaped = true" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="480" height="90" as="geometry" />
