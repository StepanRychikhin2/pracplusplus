  <diagram id="page-3" name="Пошук мінімуму та максимуму">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1900" pageScale="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Початок MinMax" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="init" value="imin = 0; imax = 0&#10;i = 1" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="i &lt; n?" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rhombus;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="min" value="arr[i] &lt;&#10;arr[imin]?" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rhombus;" vertex="1" parent="1">
          <mxGeometry x="500" y="580" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="setmin" value="imin = i" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="610" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="max" value="arr[i] &gt;&#10;arr[imax]?" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rhombus;" vertex="1" parent="1">
          <mxGeometry x="500" y="880" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="setmax" value="imax = i" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=0;" vertex="1" parent="1">
