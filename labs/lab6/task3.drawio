        <mxCell id="start" value="Початок PrintNum&#10;Вхід: up, down ≠ 0" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rounded=1;arcSize=50;" vertex="1" parent="1">
