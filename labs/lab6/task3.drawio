          <mxGeometry x="500" y="470" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="integers" value="up == p&#10;і down == q?" style="whiteSpace=wrap;html=0;fontSize=18;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;strokeWidth=2;spacing=10;rhombus;" vertex="1" parent="1">
