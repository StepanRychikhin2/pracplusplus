        <mxCell id="positive" value="m &gt; 0 і n &gt; 0?" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rhombus;" vertex="1" parent="1">
          <mxGeometry x="420" y="560" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="error" value="Вивести помилку&#10;Потрібні два натуральних числа" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="960" y="450" width="350" height="100" as="geometry" />
