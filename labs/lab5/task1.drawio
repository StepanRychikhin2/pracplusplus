        </mxCell>
        <mxCell id="loop" value="resultLoop = getGcdLoop(m, n, count)&#10;Обчислити НСД через цикл&#10;Підрахувати кількість ітерацій" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=process;" vertex="1" parent="1">
          <mxGeometry x="420" y="1290" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="outrec" value="Вивести НСД через рекурсію&#10;та глибину depth" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
