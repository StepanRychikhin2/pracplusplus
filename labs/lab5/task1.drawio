        <mxCell id="rec" value="resultRec = getGcdRec(m, n, depth)&#10;Обчислити НСД рекурсивно&#10;Підрахувати глибину викликів" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=process;" vertex="1" parent="1">
