  <diagram id="expanded-main" name="Повний алгоритм">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" page="1" pageWidth="1450" pageHeight="2210" pageScale="1">
      <root>
        <mxCell id="0" />
