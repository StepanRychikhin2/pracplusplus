        <mxCell id="calc" value="f = 1 / (2*i + 1 + f)" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="1300" width="400" height="80" as="geometry" />
