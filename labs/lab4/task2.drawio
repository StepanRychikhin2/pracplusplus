        <mxCell id="init" value="f = 0" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
