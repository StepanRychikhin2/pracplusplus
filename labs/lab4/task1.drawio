  <diagram id="page3" name="Косинус через ряд">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="900" pageScale="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s" value="cosSum(x, eps)" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="init" value="x = remainder(x, 2*pi)&#10;sum = 1; a = -x*x/2; k = 1" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="test" value="|a| &gt; eps?" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rhombus;" vertex="1" parent="1">
          <mxGeometry x="360" y="350" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sum" value="sum = sum + a&#10;k = k + 1" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="570" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="next" value="a = -a*x*x / ((2*k-1)*(2*k))" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="335" y="750" width="410" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Повернути sum" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="850" y="375" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e0" source="s" target="init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" source="init" target="test" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" source="test" target="sum" value="Так" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" source="test" target="end" value="Ні" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" source="sum" target="next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" source="next" target="test" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="Вибір формули">
    <mxGraphModel background="#ffffff" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="950" pageScale="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s" value="getSeriesValue(x, eps)" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a" value="a = cosSum(x/2, eps/10)&#10;result = 0" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="360" height="90" as="geometry" />
