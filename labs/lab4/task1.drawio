          <mxGeometry x="360" y="340" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="left" value="b = cosSum(x*x, eps/10)&#10;result = a / b" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="right" value="b = cosSum(2*x, eps/10)&#10;result = a*a*b" style="whiteSpace=wrap;html=0;fontSize=16;fontFamily=Arial;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="740" y="570" width="360" height="90" as="geometry" />
